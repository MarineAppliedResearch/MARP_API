{
  "name": "marp-mosaic-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MARP Picture Mosaic Reviewer \u2014 interactive prototype. Owns its own test suite so it can be extracted from MARP_API without untangling anything.",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm run lint && node --test \"tests/unit/*.test.mjs\"",
    "test:api": "playwright test --project=api --project=api-phone",
    "test:api:headed": "playwright test --project=api --headed",
    "demo": "node tools/record-demo.mjs",
    "demo:narrated": "node tools/record-demo.mjs --narrate",
    "demo:all": "node tools/record-demo.mjs all --narrate",
    "lint": "node tools/syntax-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
