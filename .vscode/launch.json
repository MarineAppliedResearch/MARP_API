{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch server.js",
            "program": "${workspaceFolder}/server.js",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch via nodemon (auto-restart)",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/nodemon",
            // On Windows the npm shim is a .cmd file; without this the debugger
            // fails to spawn nodemon.
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/nodemon.cmd"
            },
            "program": "${workspaceFolder}/server.js",
            "envFile": "${workspaceFolder}/.env",
            "restart": true,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Jest tests (all)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": [
                "--runInBand",
                "--forceExit"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Jest tests (current file)",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": [
                "--runInBand",
                "--forceExit",
                "--runTestsByPath",
                "${relativeFile}"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            // The frontend applications keep their own suites and their own
            // dependencies. None of these need the database or a .env.
            "type": "node-terminal",
            "request": "launch",
            "name": "Mosaic Reviewer: all tests",
            "command": "npm run test:app:mosaic-review"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Mosaic Reviewer: unit tests (fast)",
            "command": "npm run test:app:mosaic-review:unit"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Mosaic Reviewer: Playwright (desktop + phone)",
            "command": "npm run test:app:mosaic-review:e2e"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Mosaic Reviewer: Playwright, watch it run",
            "command": "npm run test:e2e:headed",
            "cwd": "${workspaceFolder}/frontend/apps/marp-mosaic-review"
        },
        {
            // Breakpoints in src/model/ work here: no browser, no server.
            "type": "node",
            "request": "launch",
            "name": "Debug Mosaic Reviewer model tests",
            "cwd": "${workspaceFolder}/frontend/apps/marp-mosaic-review",
            "runtimeArgs": [
                "--test"
            ],
            "program": "${workspaceFolder}/frontend/apps/marp-mosaic-review/tests/unit/model.test.mjs",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Mosaic Reviewer: serve standalone",
            "command": "npm run serve:app:mosaic-review"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Mosaic Reviewer: record narrated walkthroughs",
            "command": "npm run demo:app:mosaic-review"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Generate API docs",
            "command": "npm run docs:api:build"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Generate dev docs",
            "command": "npm run docs:dev:build"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Generate ERD docs",
            "command": "npm run docs:erd"
        },
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Generate API + dev docs",
            "command": "npm run docs:build"
        }
    ]
}
