{
  "source": {
    "include": [
      "."
    ],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|/|\\\\)(node_modules|docs|coverage|dist|build)(/|\\\\)"
  },
  "opts": {
    "destination": "docs/developer",
    "recurse": true,
    "readme": "README.md",
    "template": "node_modules/docdash"
  },
  "templates": {
    "default": {
      "includeDate": false
    }
  },
  "docdash": {
    "static": true,
    "sort": true,
    "search": true,
    "collapse": true,
    "typedefs": true,
    "removeQuotes": "none"
  }
}