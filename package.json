{
  "name": "mare-api",
  "version": "1.0.0",
  "description": "MARP API and static frontend applications: Express, Sequelize, and PostgreSQL, with the MARP video engine.",
  "main": "server.js",
  "scripts": {
    "start": "node ./server.js",
    "dev": "nodemon ./server.js",
    "test": "jest --runInBand --forceExit",
    "docs:api:build": "node ./scripts/generate-openapi.js",
    "docs:schema:infer": "node ./scripts/infer-openapi-schema.js",
    "docs:erd": "node ./sequelize-erd.js",
    "docs:dev:build": "jsdoc -c ./jsdoc.config.json --lenient",
    "docs:build": "npm run docs:api:build && npm run docs:dev:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarineAppliedResearch/MARE_API.git"
  },
  "keywords": [],
  "author": "Isaac Assegai Travers",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MarineAppliedResearch/MARE_API/issues"
  },
  "homepage": "https://github.com/MarineAppliedResearch/MARE_API#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@techntools/sequelize-to-openapi": "^1.4.0",
    "argon2": "^0.45.1",
    "connect-session-sequelize": "^8.0.6",
    "cors": "^2.8.5",
    "csv-stringify": "^6.6.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pine": "^1.1.1",
    "sequelize": "^6.28.0",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.0",
    "swagger-jsdoc": "^6.2.5",
    "swagger-ui-express": "^4.5.0"
  },
  "devDependencies": {
    "docdash": "^2.0.2",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "nodemon": "^2.0.7",
    "sequelize-erd": "^1.3.1",
    "supertest": "^7.2.2"
  }
}
