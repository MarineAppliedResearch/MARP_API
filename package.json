{
  "name": "nodejs-restapi-mongo",
  "version": "1.0.0",
  "description": "Example Project on how to build and develop REST API with NodeJS and MongoDB",
  "main": "index.js",
  "scripts": {
    "start": "node ./server.js",
    "dev": "nodemon ./server.js localhost 3081",
    "test": "jest --runInBand --forceExit",
    "docs:api:build": "node ./scripts/generate-openapi.js",
    "docs:erd": "node ./sequelize-erd.js",
    "docs:dev:build": "jsdoc -c ./jsdoc.config.json --lenient",
    "docs:build": "npm run docs:api:build && npm run docs:dev:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbachi/nodejs-restapi-mongo.git"
  },
  "keywords": [],
  "author": "Isaac Assegai Travers",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bbachi/nodejs-restapi-mongo/issues"
  },
  "homepage": "https://github.com/bbachi/nodejs-restapi-mongo#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-stringify": "^6.6.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pine": "^1.1.1",
    "sequelize": "^6.28.0",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.0",
    "swagger-jsdoc": "^6.2.5",
    "swagger-ui-express": "^4.5.0"
  },
  "devDependencies": {
    "docdash": "^2.0.2",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "nodemon": "^2.0.7",
    "sequelize-erd": "^1.3.1",
    "supertest": "^7.2.2"
  }
}
