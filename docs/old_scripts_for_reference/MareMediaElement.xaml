<!--
    File: MareMediaElement.xaml

    WPF wrapper control for MARE video playback using WebView2.

    This control exposes the subset of the WPF MediaElement API used by
    the MARE annotation GUI while internally rendering video through the
    browser video element. The displayed-frame clock comes from
    requestVideoFrameCallback metadata.mediaTime.
-->

<UserControl x:Class="VIDEO_PLAYER.MareMediaElement"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Focusable="True"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid x:Name="rootGrid"
          Background="Black">

        <!-- CompositionControl is required here so the WPF overlay remains a real
             interactive WPF layer above the browser video. Regular WebView2 can
             steal keyboard focus from overlay TextBoxes. -->
        <wv2:WebView2CompositionControl x:Name="webVideo"
                                        Focusable="False"
                                        IsTabStop="False" />

        <!-- Existing VideoPlayer.xaml overlay gets moved here through OverlayContent. -->
        <ContentPresenter x:Name="overlayPresenter"
                          Focusable="False" />

    </Grid>
</UserControl>