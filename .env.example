# MARP API — example environment file
#
# Copy this file to `.env` in the repository root and fill in real values:
#
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored and must never be committed. This example file must
# never contain real credentials, only variable names and safe placeholders.
#
# Every variable the codebase reads is listed here. Variables marked REQUIRED
# must be set for the API to start and serve requests; the rest are only needed
# for the integration or tooling named in their section.


# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------

# Selects the Sequelize configuration block in config/config.js and controls
# production-only safety checks. Use `development` for local work.
NODE_ENV=development

# TCP port the API listens on. Defaults to 3000 when unset.
#
# If the API cannot bind, something else already holds the port. Set a different
# one here rather than hunting for what has it.
PORT=3000

# Device name the API reports to Jellyfin when authenticating a session.
# Falls back to `marp-api` when unset. Optional.
# HOSTNAME=marp-dev-windows


# ---------------------------------------------------------------------------
# Primary application database (PostgreSQL)  — REQUIRED
# ---------------------------------------------------------------------------
# Read by config/config.js, which serves both the running API (via
# model/index.js) and the Sequelize CLI for migrations and seeders.
#
# `marp db up` in the umbrella workspace produces a development database and
# prints these five values; `marp db env` prints them again at any time. No
# host or port is written here on purpose -- a literal in this file goes stale
# the first time anyone runs `db up --port`, and nothing notices.
#
# Point these at the DEVELOPMENT database. Never at the live server.

DB_HOST=replace-with-the-host-db-env-printed
DB_PORT=replace-with-the-port-db-env-printed
DB_NAME=replace-with-development-database-name
DB_USER=replace-with-development-role
DB_PASSWORD=replace-with-development-password
DB_DIALECT=postgres


# ---------------------------------------------------------------------------
# Sessions and authentication
# ---------------------------------------------------------------------------
# Read by auth/auth.setup.js. AUTH_SESSION_SECRET is preferred; SESSION_SECRET
# is accepted as a fallback for older configurations.
#
# In production the API refuses to start unless one of these is set. In
# development an insecure fallback is used and a warning is logged, so setting
# a local value keeps the startup output clean.

AUTH_SESSION_SECRET=replace-with-a-long-random-development-secret
# SESSION_SECRET=

# -----------------------------------------------------------------------------
# First administrator
# -----------------------------------------------------------------------------
# Display name of the account that receives the `admin` permission when
# migrations run. The account is created if it does not already exist, so this
# becomes the first administrator of a new deployment.
#
# Set this before running migrations on a fresh database. Defaults to
# "MARP Admin" if unset. Changing it afterwards does not move the permission --
# grant it through the V2 users API instead.
#
# No password is set by migration; credentials are configured separately.
BOOTSTRAP_ADMIN_NAME=replace-with-your-first-administrator-name


# ---------------------------------------------------------------------------
# HTTPS (optional)
# ---------------------------------------------------------------------------
# Read by server.js. When BOTH are set the server starts with HTTPS using these
# PEM files; otherwise it starts plain HTTP. Leave unset for local development.

# HTTPS_KEY_PATH=
# HTTPS_CERT_PATH=


# ---------------------------------------------------------------------------
# Jellyfin media server
# ---------------------------------------------------------------------------
# Read by repository/jellyfin.repository.js. Required for any route that
# resolves media, and for video playback in the player.
#
# Development normally points at the production Jellyfin server, which holds
# the real media library. A separate development instance exists for isolated
# experiments; its address and account are in .marp/local/hosts.md, never here.

JELLYFIN_BASE_URL=https://replace-with-jellyfin-server
JELLYFIN_USERNAME=replace-with-jellyfin-user
JELLYFIN_PASSWORD=replace-with-jellyfin-password


# ---------------------------------------------------------------------------
# Reporting database (PostgreSQL)
# ---------------------------------------------------------------------------
# Read by reporting/db.js and test-reporting.js. This is a separate connection
# from the DB_* block above and is typically a read-only role.
#
# These have NO fallback defaults by design. Leave them unset unless you are
# working on reporting, and when you do set them, point them at a development
# server — not the live reporting host.

# REPORT_PGHOST=
# REPORT_PGPORT=5432
# REPORT_PGUSER=
# REPORT_PGPASSWORD=
# REPORT_PGDATABASE=
# Set to `true` only if the reporting server requires SSL.
# REPORT_PGSSL=false
# Per-query statement timeout in milliseconds. Defaults to 30000.
# REPORT_QUERY_TIMEOUT_MS=30000


# ---------------------------------------------------------------------------
# Video-engine tests and probes
# ---------------------------------------------------------------------------
# Only needed when running the video-engine Playwright E2E suite
# (`npm run test:video-engine:e2e`) or the manual probes under
# video-engine/test/probes/.

# Base URL the E2E suite and probes load the player from.
# Defaults to http://localhost:3000/apps/VideoPlayer/
# VIDEO_ENGINE_TEST_URL=http://localhost:3000/apps/VideoPlayer/

# Jellyfin server the E2E suite authenticates against. The Jellyfin suites fail
# with a clear message when these are unset.
# VIDEO_ENGINE_TEST_JELLYFIN_URL=http://localhost:8096
# VIDEO_ENGINE_TEST_JELLYFIN_USERNAME=
# VIDEO_ENGINE_TEST_JELLYFIN_PASSWORD=

# Absolute path to a local .mp4 fixture, used by the local-file media-source
# tests and probes. These suites are skipped when this is unset, so Windows
# developers without a fixture copy can still run the rest of the suite.
# Windows example: C:\MARE_CODE_DEVELOPMENT\test-fixtures\video-engine\fixtures\long-gop-faststart.mp4
# VIDEO_ENGINE_TEST_LOCAL_FILE=

# Directory holding the generated fixture set, used by
# video-engine/test/probes/fixture-manifest.mjs.
# VIDEO_ENGINE_FIXTURE_DIR=

# Absolute path to the original source .mp4 used as the reference for the
# frame-correctness probe.
# FRAME_REFERENCE_FILE=

# Jellyfin item and credentials used by the standalone probe scripts under
# video-engine/test/probes/. Separate from the VIDEO_ENGINE_TEST_* set above
# because the probes run outside the Playwright config.
# JELLYFIN_ITEM=
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_USER=
# JELLYFIN_PASS=
